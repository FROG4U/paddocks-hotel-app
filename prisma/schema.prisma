// The Paddocks Hotel - database schema (SQLite)
// Everything editable from /admin lives here. Public pages render with
// `force-dynamic`, so edits appear on the live site instantly (no rebuild).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Admin login ──
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Global site settings: contact, hours, social, brand (single row id=1) ──
model SiteSettings {
  id       Int    @id @default(1)

  siteName String @default("The Paddocks Hotel")
  tagline  String @default("In the heart of Ross-on-Wye")
  logoUrl  String @default("/brand/logo.png")

  // Brand colours
  navyColor   String @default("#0a416c")
  accentColor String @default("#e23125")
  goldColor   String @default("#ba9667")
  buttonColor String @default("#ba9667")

  // Contact
  addressLine1 String @default("The Paddocks Hotel, Wye View Lane")
  addressLine2 String @default("Symonds Yat West")
  town         String @default("Ross-on-Wye")
  postcode     String @default("HR9 6BL")
  phone        String @default("01600 890 246")
  email        String @default("reception@paddockshotel.com")
  mapQuery     String @default("The Paddocks Hotel, Wye View Ln, Symonds Yat West, Ross-on-Wye HR9 6BL")

  // Opening hours (one line per day-range)
  hoursJson String @default("[{\"label\":\"Mon-Fri\",\"value\":\"5pm - 10.30pm\"},{\"label\":\"Saturday\",\"value\":\"5pm - 11.00pm\"}]")

  // Social links
  facebookUrl  String @default("https://facebook.com")
  instagramUrl String @default("https://instagram.com")
  googleUrl    String @default("")
  tiktokUrl    String @default("")

  // Booking call-to-action
  bookCtaLabel String @default("Book a Room")
  bookCtaHref  String @default("/contact")

  // SEO defaults + footer
  siteUrl         String @default("https://paddockshotel.com")
  metaTitle       String @default("The Paddocks Hotel | Hotel & Restaurant, Symonds Yat West, Ross-on-Wye")
  metaDescription String @default("Family-run hotel and Indian restaurant in Symonds Yat West, Ross-on-Wye. En-suite rooms, wedding and party venue, and a bar in the heart of the Wye Valley.")
  metaKeywords    String @default("hotel Ross-on-Wye, Symonds Yat hotel, Wye Valley hotel, wedding venue Ross-on-Wye, Indian restaurant Ross-on-Wye, bed and breakfast Symonds Yat, Forest of Dean hotel")
  ogImage         String @default("/uploads/home.jpg")
  geoLat          String @default("51.8408")
  geoLng          String @default("-2.6478")
  footerNote      String @default("© The Paddocks Hotel. All rights reserved.")

  updatedAt DateTime @updatedAt
}

// ── Content pages (home, weddings, celebrations, dance, meeting, bar, contact) ──
// navGroup controls the dropdown a page appears under: "" | "explore" | "food"
model Page {
  id        String  @id @default(cuid())
  slug      String  @unique
  title     String                        // admin-facing label
  navLabel  String  @default("")          // menu text (blank = hidden from nav)
  navGroup  String  @default("")          // "", "explore", "food"
  order     Int     @default(0)
  showInNav Boolean @default(true)

  heroEyebrow  String @default("")
  heroTitle    String @default("")
  heroSubtitle String @default("")
  heroImage    String @default("")

  // Repeatable content blocks: [{heading, body, image, imageSide}]
  sectionsJson String @default("[]")

  metaTitle       String @default("")
  metaDescription String @default("")
  keywords        String @default("")

  updatedAt DateTime @updatedAt
}

// ── Rooms (appear under the "Our Rooms" dropdown; each is its own page) ──
model Room {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  order       Int     @default(0)
  heroEyebrow String  @default("Book Our")
  heroImage   String  @default("")
  shortDesc   String  @default("")
  description String  @default("")
  price       String  @default("")
  showPrice   Boolean @default(true)

  metaTitle       String @default("")
  metaDescription String @default("")
  keywords        String @default("")

  updatedAt DateTime @updatedAt
}

// ── Explore: cards linking out to things to do in the local area ──
// Each card is a photo, a title, a short description and a button that
// opens an external website in a new tab. Managed from /admin/explore.
model ExploreItem {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String  @default("")
  image       String  @default("")
  linkUrl     String  @default("")
  buttonLabel String  @default("View")
  order       Int     @default(0)
  published   Boolean @default(true)

  updatedAt DateTime @updatedAt
}

// ── AI SEO drafts ──
// A suggestion from the AI assistant, held until the owner applies or
// discards it. One draft per page or room.
model SeoDraft {
  id           String   @id @default(cuid())
  targetType   String   // "page" | "room"
  targetId     String
  targetName   String
  metaTitle    String   @default("")
  metaDescription String @default("")
  keywords     String   @default("")
  bodyText     String   @default("")
  notes        String   @default("")
  createdAt    DateTime @default(now())

  @@unique([targetType, targetId])
}
